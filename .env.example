# Settings for Docker (docker compose). Copy to .env and fill in.
# Never commit .env: it holds your secrets.

# Required: any long random string (e.g. run: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())")
JWT_SECRET=

# Optional: Claude. Leave empty to use the free offline engine.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
AI_ENGINE=auto

# Optional: use MongoDB Atlas instead of the bundled database
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/clarify
# MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1

# The address people open in the browser
WEB_URL=http://localhost:3100
WEB_PORT=3100
# Set to true only when served over https
COOKIE_SECURE=false
