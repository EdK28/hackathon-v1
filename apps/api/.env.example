# Copy to .env and fill in.

PORT=4100
# Same Atlas cluster as the shop is fine, just use a different database name (clarify)
MONGO_URI=mongodb://127.0.0.1:27017/clarify?replicaSet=rs0
# If you get "querySrv ECONNREFUSED" with mongodb+srv://, uncomment:
# MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1
JWT_SECRET=change-me-to-a-long-random-string
WEB_URL=http://localhost:3100
COOKIE_SECURE=false

# AI engine: auto (Claude if a key is set, else a free model if LLM_BASE_URL is set, else offline) | claude | llm | offline
AI_ENGINE=auto
# Get a key at https://platform.claude.com (API keys). Leave empty to use the offline engine.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Free / open models (any OpenAI-compatible API) -------------------------
# Used when AI_ENGINE=llm, or in auto mode when ANTHROPIC_API_KEY is empty.
# Ollama (free, runs on your PC, no key): install from ollama.com, run `ollama pull qwen3:8b`
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:8b
# LLM_API_KEY=
# Groq (free tier, fast, needs a free key from console.groq.com):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=your-groq-key
# OpenRouter (":free" models, free key from openrouter.ai):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# LLM_API_KEY=your-openrouter-key
# Local models can be slow on the first message while they load:
# LLM_TIMEOUT_MS=180000
